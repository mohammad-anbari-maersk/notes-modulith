<configuration>

    <property name="LOG_PATTERN" value="%green(notes-modulith) - %cyan(%date [%thread] %-5level %logger{36}) - %message%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="dev.nils.notes_modulith" level="DEBUG"/>
    <logger name="org.springframework.modulith" level="DEBUG"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
